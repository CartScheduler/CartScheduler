{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "noEmit": true,
    "types": [
      "vitest/globals",
      "chai",
      "node",
      "types/vue"
    ]
  },
  // The root config excludes the test directory; this config exists to check
  // it, so the exclusion is lifted here.
  "exclude": [],
  "include": [
    "./vitest.config.ts",
    "./resources/js/**/*.ts",
    "./resources/js/**/*.tsx",
    "./resources/js/**/*.vue"
  ]
}
