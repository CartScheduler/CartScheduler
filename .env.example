APP_NAME="Cart Scheduler"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_TIMEZONE=UTC
FORCE_HTTPS=false
BUGSNAG_API_KEY=

# This could correespond to the number of CA_SHIFT_RESERVATION_DURATION_PERIODs.
# For example, if CA_SHIFT_RESERVATION_DURATION_PERIOD is set to WEEK and CA_SHIFT_RESERVATION_DURATION is set to 2,
# then the scheduled shifts will be released 2 weeks after the shift is scheduled.
CA_SHIFT_RESERVATION_DURATION=1
# Should match up with DBPeriod enum
CA_SHIFT_RESERVATION_DURATION_PERIOD=MONTH
# Release new shifts daily or at the beginning of the CA_SHIFT_RESERVATION_DURATION_PERIOD
CA_SHIFT_RESERVATION_DAILY_RELEASE_SCHEDULE=false
# If CA_SHIFT_RESERVATION_DURATION_PERIOD is set to WEEK and CA_SHIFT_RESERVATION_DAILY_RELEASE_SCHEDULE is false,
# sheduled shifts will be released on the corresponding day of the week. 3 letter day name only.
# SUN, MON, TUE, WED, THU, FRI, SAT
CA_SHIFT_RESERVATION_WEEK_RELEASE_DAY=MON
# If CA_SHIFT_RESERVATION_DAILY_RELEASE_SCHEDULE is false,
# 24 hour time. Eg. 12:00 will release new shifts at 12:00pm
CA_SHIFT_RESERVATION_NEW_RELEASE_TIME=12:00
# Email volunteers when a new reservation period is released with their pre-assigned shifts
CA_SHIFT_ASSIGNMENT_NOTIFICATIONS_ENABLED=false
# How many days sent and failed notifications stay in the log (Admin > Notifications)
CA_NOTIFICATION_LOG_RETENTION_DAYS=90
# How many days failed queue jobs are kept for retrying (Admin > Queue)
CA_FAILED_JOB_RETENTION_DAYS=30
# The most emails the queue sends per minute. Check your host's hourly sending limit.
CA_MAIL_RATE_PER_MINUTE=30
# Start a queue worker from the scheduler each minute. Set to false if Supervisor runs `queue:work`.
CA_RUN_QUEUE_WORKER_FROM_SCHEDULER=true

# MAX number of volunteers that can be scheduled for a shift. Note, this has only been tested with a max of 5.
CA_MAX_VOLUNTEERS_PER_SHIFT=4

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=example_app
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Local: sync (jobs run inline, no worker needed).
# Production: database. All emails are sent from the queue. The scheduler (the schedule:run cron) starts
# a worker every minute, so no extra cron or Supervisor is needed. Admin > Queue shows whether it's working.
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local Sail/Docker: Mailpit (UI http://localhost:8025). Production: use ses / smtp / sendmail as appropriate.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="hello@example.com"
MAIL_SUPPORT_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
